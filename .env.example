# Required — Gemini API key for the intake assistant
GOOGLE_API_KEY=AIza...

# API access key (optional — when set, the API requires it via x-api-key
# or the portal's session cookie; never sent to the browser)
FRONT_DOOR_API_KEY=...

# Slack (optional — bot won't start without these; socket mode, no signing secret needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Channel for lifecycle notifications from Worksome webhooks (optional)
SLACK_NOTIFY_CHANNEL=#hiring

# Worksome API (optional — enables post-routing job creation)
WORKSOME_API_TOKEN=eyJ0eXAi...
WORKSOME_API_URL=https://api.sandbox.worksome.com/graphql

# Worksome webhooks (optional — shared secret agreed with Worksome;
# enables POST /api/webhooks/worksome lifecycle tracking)
WORKSOME_WEBHOOK_SECRET=...

# GitHub talent discovery (optional — higher rate limits when set)
GITHUB_TOKEN=ghp_...

# Fast-track mutations (opt-in; verify against your sandbox first with
# `node scripts/introspect-worksome.js` to confirm input field shapes)
# FAST_TRACK_INVITE=1       — new worker: auto-create the trusted contact (sends the invite)
# FAST_TRACK_DRAFT_HIRE=1   — known worker: pre-create job + draft hire
# FAST_TRACK_MILESTONES=1   — fixed-price work: scaffold a delivery milestone on the job

# Optional overrides (defaults come from the server-side config store)
PORT=3000
ASSISTANT_NAME=Worksome Hiring Hub
VMS_NAME=Beeline
WORKSOME_URL=https://sandbox.worksome.com/login
VMS_URL=https://beeline.com
